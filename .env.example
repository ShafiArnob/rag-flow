# Copy to .env and edit. Never commit .env.

# --- Compose infrastructure (infra/docker-compose.yml) ---
# The Postgres superuser. Only the one-shot db-bootstrap service uses it, to create the extensions and
# the two roles below. Compose puts every database password into a URL unencoded, so use only letters,
# digits and . _ ~ -
POSTGRES_USER=flowbuilder
POSTGRES_PASSWORD=change-me
POSTGRES_DB=flowbuilder

# Passwords for the roles db-bootstrap creates: flowbuilder_owner (owns the schema; the migrate
# service runs Alembic as it) and flowbuilder_app (the api and worker; row-level security applies).
# Dev-only placeholders: change them. At least 16 characters of letters, digits and . _ ~ -
DATABASE_OWNER_PASSWORD=change-me-owner-password
DATABASE_APP_PASSWORD=change-me-app-password
# Host port published on 127.0.0.1 (optional, default 5432)
POSTGRES_PORT=5432

MINIO_ROOT_USER=flowbuilder
MINIO_ROOT_PASSWORD=change-me-too
# Host ports published on 127.0.0.1 (optional, defaults 9000 and 9001)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Host port for the API (optional, default 8000)
API_PORT=8000

# Host port for the frontend (optional, default 3000)
FRONTEND_PORT=3000

# --- Backend settings (read by app.config.Settings) ---
# Inside Compose the host names below are overridden with service names; these values are
# for running the backend and migrations directly on your machine. The integration tests refuse any
# database whose name doesn't end in _test; run them with infra/docker-compose.test.yml.
# The api, worker and seed connect as the app role.
DATABASE_URL=postgresql+asyncpg://flowbuilder_app:change-me-app-password@localhost:5432/flowbuilder
# Alembic and app.runs.partitions connect as the owner role.
MIGRATION_DATABASE_URL=postgresql+asyncpg://flowbuilder_owner:change-me-owner-password@localhost:5432/flowbuilder
# app.database.bootstrap connects as the superuser.
BOOTSTRAP_DATABASE_URL=postgresql+asyncpg://flowbuilder:change-me@localhost:5432/flowbuilder
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_HEALTH_URL=http://localhost:9000/minio/health/ready
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Whether the session cookie carries the Secure attribute, so browsers send it only over HTTPS.
# Required. false only for local development over plain HTTP. WARNING: production must use true.
SESSION_COOKIE_SECURE=false
# Optional, default flowbuilder-api
OTEL_SERVICE_NAME=flowbuilder-api
# DEBUG, INFO, WARNING or ERROR (optional, default INFO)
LOG_LEVEL=INFO
